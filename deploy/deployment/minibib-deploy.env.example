APP_ROOT=/srv/minibib/current
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=main

HEALTH_BASE_URL=https://bibliothek.example.invalid
HEALTH_TIMEOUT_SECONDS=15

PHP_BINARY=/usr/bin/php
COMPOSER_BINARY=/usr/local/bin/composer
NPM_BINARY=/usr/bin/npm
CURL_BINARY=/usr/bin/curl

RUN_BACKUP_BEFORE_DEPLOY=true
BACKUP_COMMAND=/usr/local/sbin/minibib-backup
BACKUP_ENV_FILE=/etc/minibib/backup.env
